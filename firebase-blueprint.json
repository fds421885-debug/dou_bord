{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile containing verified identity and four-part name",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullNameQuad": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullNameQuad", "email", "createdAt", "updatedAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Synchronized classroom quiz session managed by a supervisor",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "supervisorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "supervisorName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "active", "finished"]
        },
        "currentQuestionId": {
          "type": "string",
          "maxLength": 128
        },
        "questionCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "supervisorId",
        "supervisorName",
        "status",
        "currentQuestionId",
        "questionCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Participant": {
      "title": "Participant",
      "description": "Student participating in a classroom room",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullNameQuad": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "score": {
          "type": "integer"
        },
        "correctCount": {
          "type": "integer"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "roomId",
        "fullNameQuad",
        "score",
        "correctCount",
        "joinedAt",
        "updatedAt"
      ]
    },
    "Question": {
      "title": "Question",
      "description": "Question inserted by the supervisor for students to solve",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": {
          "type": "integer"
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "imageData": {
          "type": "string",
          "maxLength": 280000
        },
        "status": {
          "type": "string",
          "enum": ["solving", "correct", "unanswered"]
        },
        "attemptsUsed": {
          "type": "integer"
        },
        "wrongStudentIds": {
          "type": "array"
        },
        "winnerId": {
          "type": "string",
          "maxLength": 128
        },
        "winnerName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "roomId",
        "orderIndex",
        "text",
        "imageData",
        "status",
        "attemptsUsed",
        "wrongStudentIds",
        "winnerId",
        "winnerName",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentBoard": {
      "title": "StudentBoard",
      "description": "Individual student whiteboard strokes and submission status for a question",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "questionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "strokes": {
          "type": "array"
        },
        "submitted": {
          "type": "boolean"
        },
        "verdict": {
          "type": "string",
          "enum": ["pending", "correct", "wrong"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "studentId",
        "studentName",
        "roomId",
        "questionId",
        "strokes",
        "submitted",
        "verdict",
        "updatedAt"
      ]
    },
    "SavedTest": {
      "title": "SavedTest",
      "description": "Personal saved test archive owned by a student or supervisor",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "userRole": {
          "type": "string",
          "enum": ["supervisor", "student"]
        },
        "supervisorName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "totalQuestions": {
          "type": "integer"
        },
        "participantsSummary": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "roomCode",
        "title",
        "userRole",
        "supervisorName",
        "totalQuestions",
        "participantsSummary",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedQuestion": {
      "title": "SavedQuestion",
      "description": "Archived question with all student whiteboards inside a user's saved test",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": {
          "type": "integer"
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "imageData": {
          "type": "string",
          "maxLength": 280000
        },
        "status": {
          "type": "string",
          "enum": ["solving", "correct", "unanswered"]
        },
        "winnerName": {
          "type": "string",
          "maxLength": 120
        },
        "boards": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "orderIndex",
        "text",
        "imageData",
        "status",
        "winnerName",
        "boards",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile with email and four-part name"
    },
    "/users/{userId}/savedTests/{testId}": {
      "schema": { "$ref": "#/entities/SavedTest" },
      "description": "Personal saved test metadata owned by the user"
    },
    "/users/{userId}/savedTests/{testId}/questions/{questionId}": {
      "schema": { "$ref": "#/entities/SavedQuestion" },
      "description": "Saved question and all student whiteboards for a saved test"
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Live classroom room keyed by room code"
    },
    "/rooms/{roomId}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "Students joined to the room"
    },
    "/rooms/{roomId}/questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Questions published by the supervisor"
    },
    "/rooms/{roomId}/questions/{questionId}/boards/{studentId}": {
      "schema": { "$ref": "#/entities/StudentBoard" },
      "description": "Individual student whiteboard state per question"
    }
  }
}
